{
  "name": "sui",
  "private": true,
  "type": "module",
  "workspaces": ["site"],
  "scripts": {
    "dev": "bun run --cwd site dev",
    "build": "bun run registry:build && bun run --cwd site build",
    "registry:build": "bun scripts/build-registry.ts && bun scripts/gen-llms.ts",
    "docs:llms": "bun scripts/gen-llms.ts",
    "report:spacing": "bun scripts/report-spacing.ts",
    "check": "bun run --cwd site typecheck && bun run lint",
    "lint": "eslint .",
    "test": "bun test tests",
    "smoke": "bun scripts/smoke.ts",
    "audit": "bun scripts/audit.ts",
    "deploy": "SUI_REGISTRY_URL=https://sui.dame.gg/r bun run build && bunx wrangler deploy"
  },
  "devDependencies": {
    "@shadcn/lint": "latest",
    "@typescript-eslint/parser": "latest",
    "axe-core": "^4.14.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "latest",
    "playwright-core": "^1.64.1",
    "vue-eslint-parser": "latest"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44"
  }
}
